# DEFAULT
CONTAINER_PORT=8080

# LOCALSTACK
LOCALSTACK_TOKEN=REPLACE_WITH_YOUR_LOCALSTACK_PRO_TOKEN
LOCALSTACK_HOST=127.0.0.1
LOCALSTACK_PORT1=4566
LOCALSTACK_PORT2=4510-4559
LOCALSTACK_IMAGE_TAG=latest
LOCALSTACK_SERVICES=s3,sqs,sns,iam,sts,lambda,apigateway,logs,kms,ses,cloudwatch
ALLOW_DEV_STAGE_BYPASS=false
LOCALSTACK_ENDPOINT=http://localhost.localstack.cloud:4566

# Terraform / AWS
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_DEFAULT_REGION=us-east-1
AWS_SESSION_TOKEN=test

# REDIS
REDIS_PASSWORD=admin
REDIS_HOST=6379
REDIS_PORT=6379

# REDIS INSIGHT
REDISINSIGHT_HOST=5540
REDISINSIGHT_PORT=5540

# POSTGRES
POSTGRES_USER=postgresAdmin
POSTGRES_PASSWORD=postgresAdmin
POSTGRES_HOST_PORT=5444
POSTGRES_CONTAINER_PORT=5432

# PGADMIN 
# Acesse o pgAdmin na URL http://localhost:5050
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT1=5050
PGADMIN_PORT2=80

# SQS
SQS_REGION=us-east-1
SQS_ACCESS_KEY=test
SQS_SECRET_KEY=test
SQS_SERVICE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/
SQS_EMAIL_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/notification-queue
SQS_DONATION_QUEUE_URL=http://sqs.us-east-1.localhost.localstack.cloud:4566/000000000000/process-donation-payment

# APIs (campaigns-api, users-api, donation-worker)
CAMPAIGNS_API_PORT=30081
USERS_API_PORT=30084
FIREBASE_CREDENTIAL_JSON=REPLACE_WITH_FIREBASE_SERVICE_ACCOUNT_JSON_CONTENT
FIREBASE_APIKEY=REPLACE_WITH_FIREBASE_API_KEY